# Environment of the cozy-stack e2e scenarios (tests/e2e/cozy/README.md).
# Copy it out of the repository, fill it in, then: set -a; . ./e2e.env; set +a

# The instance of the functional scenarios, and the one of the failure scenarios
E2E_DOMAIN=cozy.localhost:8080
E2E_FAULTS_DOMAIN=faults.cozy.localhost:8080
E2E_STACK_SCHEME=http
COZY_STACK_BIN=cozy-stack
COZY_ADMIN_PORT=6060

# openRAG, which the scenarios query directly, and the fault proxy in front of it,
# through which the stack and the indexer reach openRAG
E2E_RAG_URL=https://openrag.example
E2E_RAG_API_KEY=...
E2E_RAG_PROXY_URL=http://127.0.0.1:8106
E2E_FAULT_MODE_FILE=/tmp/rag-e2e-fault.txt

# RabbitMQ
E2E_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
E2E_RABBITMQ_MGMT_URL=http://localhost:15672/api
E2E_RABBITMQ_MGMT_AUTH=guest:guest

# Logs read by the scenarios: the indexer's (JSON, LOG_LEVEL=DEBUG) and the stack's
E2E_INDEXER_LOG=/tmp/rag-indexer.log
E2E_STACK_LOG=/tmp/cozy-stack.log
E2E_INDEXER_HEALTH_URL=http://localhost:8080/health

# Shell commands the failure scenarios run to stop and start the indexer and RabbitMQ
E2E_INDEXER_START=...
E2E_INDEXER_STOP=...
E2E_RABBITMQ_START=docker start rabbitmq
E2E_RABBITMQ_STOP=docker stop rabbitmq

# Optional: append each result, as a JSON line, to this file
# E2E_RESULTS=/tmp/rag-e2e-results.jsonl
